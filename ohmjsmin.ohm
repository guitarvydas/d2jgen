ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody


  RuleBody = BranchedItem

  BranchedItem = (BranchedAlternation | BranchedSequence | BranchedPred)
  BranchedSequence = 
    | "(" BranchedItem ")" "+" -- parenplus
    | "(" BranchedItem ")" "*" -- parenstar
    | "(" BranchedItem ")" "?" -- parenopt
    | "(" BranchedItem ")"     -- parenplain
    | BranchedItem              -- plain
  BranchedAlternation =
    | "(" AltBranchedItem ")" "+" -- parenplus
    | "(" AltBranchedItem ")" "*" -- parenstar
    | "(" AltBranchedItem ")" "?" -- parenopt
    | "(" AltBranchedItem ")"     -- parenplain
  BranchedPred = Pred

  AltBranchedItem = "|" BranchedItem

  //////////////////////////////////////////////////////////////////////////////
  // Pred returns a function call not wrapped in branching code
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
