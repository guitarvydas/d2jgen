ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (LexicalExtension | SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody
  LexicalExtension = lowercaseid "+=" RuleBody

  RuleBody =
    | Alternation -- alternates
    | Sequence           -- sequence
  Alternation = "|"? Sequence OrBranch+
  OrBranch = "|" Sequence
  Sequence = MatchItem+
  MatchItem =
    | ParenthesizedMatchItem -- paren
    | Pred "+"               -- plus
    | Pred "*"               -- star
    | Pred "?"               -- optional
    | Pred                   -- plain
  ParenthesizedMatchItem =
    | "(" Alternation ")" "+" -- orplus
    | "(" Alternation ")" "*" -- orstar
    | "(" Alternation ")" "?" -- oropt
    | "(" Alternation ")"     -- or
    | "(" Sequence  ")" "+" -- andplus
    | "(" Sequence  ")" "*" -- andstar
    | "(" Sequence  ")" "?" -- andopt
    | "(" Sequence  ")"     -- and

  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
