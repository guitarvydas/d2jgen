ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (SyntacticExtension | LexicalExtension | SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody
  SyntacticExtension = uppercaseid "+=" RuleBody
  LexicalExtension = lowercaseid "+=" RuleBody
  RuleBody = NamedAlternates RuleBody?
  NamedAlternates =
    | "|"? NamedMatchSequence AltNamed+ -- namedalts
    | UnnamedMatchSequence              -- single
  UnnamedAlternates =
    | "|"? UnnamedMatchSequence AltUnnamed+ -- unnamedalts
    | UnnamedMatchSequence                  -- single

  AltNamed = "|" NamedMatchSequence
  AltUnnamed = "|" UnnamedMatchSequence
  NamedMatchSequence = MatchSequence "--" id
  UnnamedMatchSequence = MatchSequence
  MatchSequence = MatchItem MatchSequence?
  MatchItem = 
  | ~ "(" Iter -- nonparenthesized
  | Iter       -- parenthesized
  Iter =
    | Pred "*" -- zeroormore
    | Pred "+" -- oneormore
    | Pred "?" -- optional
    | Pred     -- plain
  Pred =
    | "~" Base -- not
    |     Base -- plain
  Base =
    | "(" UnnamedAlternates ")" -- parenthesized
    | matchAtom   -- atom

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = uppercaseid | lowercaseid
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
