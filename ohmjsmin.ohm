ohmjsmin { Main = id "{" Rules "}" Rules = (LexicalExtension |
  SyntacticRule | LexicalRule)+ SyntacticRule = uppercaseid "="
  RuleBody LexicalRule = lowercaseid "=" RuleBody LexicalExtension =
  lowercaseid "+=" RuleBody


  //////////////////////////////////////////////////////////////////////////////
  // RuleBody composes SingleItems into a string of branching code and adds a
  // final accept/fail test at the end of the chain based on the boolean value
  // of ⦑retvar⦒
  //////////////////////////////////////////////////////////////////////////////
  RuleBody = SingleItem*


  //////////////////////////////////////////////////////////////////////////////
  // each SingleItem compiles into branching code based on
  // the values of ⦑retvar⦒ and ⦑conjoin⦒
  //////////////////////////////////////////////////////////////////////////////
  SingleItem = MatchItem

  MatchItem =
    | "(" MatchItem ")" "+"  -- parenplus
    | "(" MatchItem ")" "*"  -- parenstar
    | "(" MatchItem ")" "?"  -- parenopt
    | "(" MatchItem ")"      -- paren
    | Pred "+"               -- plus
    | Pred "*"               -- star
    | Pred "?"               -- optional
    | Pred                   -- plain


  //////////////////////////////////////////////////////////////////////////////
  // Pred returns a function call not wrapped in branching code
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
