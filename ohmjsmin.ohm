ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (LexicalExtension | SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody
  LexicalExtension = lowercaseid "+=" RuleBody
  RuleBody = UnnamedAlternates RuleBody?
  UnnamedAlternates =
    | AltUnnamed+ -- unnamedalts
    | UnnamedMatchSequence                  -- single

  AltUnnamed = "|" UnnamedMatchSequence
  UnnamedMatchSequence = MatchSequence
  MatchSequence = MatchItem MatchSequence?
  MatchItem = 
  | ~ "(" Iter -- nonparenthesized
  | Iter       -- parenthesized
  Iter =
    | Pred "*" -- zeroormore
    | Pred "+" -- oneormore
    | Pred "?" -- optional
    | Pred     -- plain
  Pred =
    | "~" Base -- not
    |     Base -- plain
  Base =
    | "(" ~"|" UnnamedMatchSequence ")" -- parenthesized
    | "(" &"|" UnnamedAlternates ")" -- alts
    | matchAtom   -- atom

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = uppercaseid | lowercaseid
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
