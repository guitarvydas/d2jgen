ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody



  //////////////////////////////////////////////////////////////////////////////
  // There are 3 main branching control flow blocks: SeqItem, AltItem, PredItem
  // each receives a target variable and leaves a true/false result in that variable
  //////////////////////////////////////////////////////////////////////////////

  RuleBody = Sequence

  Sequence = SeqItem+
  PredItem = Pred
  Alternation =
    | Alternation "+"  -- plus
    | "(" AltItem+ ")" -- parenthesized
  AltItem = "|" BranchingItem
  BranchingItem = (Sequence | Alternation | PredItem)
  SeqItem =
    | SeqItem "+"           -- plus
    | "(" NoBarSeqItem+ ")" -- parenthesized
    | Sequence              -- sequence
    | Alternation           -- alternation
    | PredItem "+"          -- preditemplus
    | PredItem              -- preditem
  NoBarSeqItem = ~"|" SeqItem

  //////////////////////////////////////////////////////////////////////////////
  // Pred returns a function call not wrapped in branching code
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
