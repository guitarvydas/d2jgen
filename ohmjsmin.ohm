ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody


  RuleBody = Group

  Group = (ParsingCall | AltGroup)+
  AltGroup =
    | "(" AltItem+ ")" "+" -- plus
    | "(" AltItem+ ")"     -- plain
  AltItem = "|" Group
  ParsingCall = Pred



  //////////////////////////////////////////////////////////////////////////////
  // Pred is a parsing function call not wrapped in branching code
  // the call returns
  // - a True/False on the value stack (a global variable called "value" in the RWR code)
  // - a "done" control flow blip on its output port ""
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
