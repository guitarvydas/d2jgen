peephole {
  main = match+
  match=
    | applySyntactic<SeqNNTrue> -- seqnntrue
    | applySyntactic<RandSeqFN> -- randseqfn
    | any                       -- char
  SeqNNTrue = "seq" NN "=" "True" "seq" NN "="
  RandSeqFN = id "=" id "(" Actuals? ")" id "=" id "and" "seq" NN
  Actuals =
    | "(" Actuals ")" -- rec
    | ~"(" ~")" any   -- plain
  NN = digit+
  id = letter alnum*
  comment = "#" (~nl any)* nl
  nl = "\n"
  space += comment
}
