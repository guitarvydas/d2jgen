        <mxCell id="e5nCakjjVEugJJ5n87lp-48" parent="1" style="text;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;strokeColor=default;dashed=1;" value="%rewrite ohmjsmin {&#xa;&#xa;Main [ id _1 Rules _2] = ‛«id» «_1»«Rules»\n«_2»’&#xa;Rules [ _3+] = ‛«_3»’&#xa;SyntacticRule [ uppercaseid _4 RuleBody] = ‛\n  «uppercaseid»«_4»«RuleBody»’&#xa;LexicalRule [ lowercaseid _5 RuleBody] = ‛\n  «lowercaseid»«_5»«RuleBody»’&#xa;SyntacticExtension [ uppercaseid _6 RuleBody] = ‛\n  «uppercaseid»«_6»«RuleBody»’&#xa;LexicalExtension [ lowercaseid _7 RuleBody] = ‛\n  «lowercaseid»«_7»«RuleBody»’&#xa;RuleBody [ MatchItem+] = ‛«MatchItem»’&#xa;MatchItem_parenthesizedplus [ _8 MatchItem+ _9 plussuffix] =‛ «_8»«MatchItem»«_9»«plussuffix»’&#xa;MatchItem_parenthesized [ _10 MatchItem+ _11] =‛ «_10»«MatchItem»«_11»’&#xa;MatchItem_string [ dqstring] =‛ «dqstring»’&#xa;MatchItem_notprefixed [ notprefix MatchItem] =‛ «notprefix»«MatchItem»’&#xa;MatchItem_plussuffixed [ MatchItem plussuffix] =‛ «MatchItem»«plussuffix»’&#xa;MatchItem_alts [ MatchItem AlternateItem+] =‛ «MatchItem»«AlternateItem»’&#xa;MatchItem_single [ id] =‛ «id»’&#xa;AlternateItem [ _14 MatchItem] = ‛ «_14» «MatchItem»’&#xa;plussuffix [ _15] = ‛«_15»’&#xa;notprefix [ _17] = ‛«_17»’&#xa;dqstring [ _18 sqchar+ _19] = ‛«_18»«sqchar»«_19»’&#xa;sqchar_escdq [ _20 _21] =‛«_20»«_21»’&#xa;sqchar_any [ any] =‛«any»’&#xa;id [ _23] = ‛«_23»’&#xa;uppercaseid [ upper alnum*] = ‛«upper»«alnum»’&#xa;lowercaseid [ lower alnum*] = ‛«lower»«alnum»’&#xa;}" vertex="1">
