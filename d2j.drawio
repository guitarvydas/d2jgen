        <mxCell id="e5nCakjjVEugJJ5n87lp-43" parent="1" style="text;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;strokeColor=default;dashed=1;" value="d2j {&#xa;  Main = Array&#xa;  Array = &quot;[&quot; (KV | Object)+ &quot;]&quot;&#xa;  Object = &quot;{&quot; KV+ &quot;}&quot;&#xa;  KV = keystring &quot;:&quot; (Array | Object | string | emptyString | number)&#xa;  string = &quot;\&quot;&quot; (~&quot;\&quot;&quot; any)+ &quot;\&quot;&quot;&#xa;  keystring = string&#xa;  emptyString = &quot;\&quot;&quot; &quot;\&quot;&quot;&#xa;  number = digit+&#xa;  space += &quot;,&quot;&#xa;}" vertex="1">
