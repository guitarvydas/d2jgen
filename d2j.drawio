        <mxCell id="e5nCakjjVEugJJ5n87lp-46" parent="1" style="text;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="ohmjsmin {&#xa;  Main = id &quot;{&quot; Rules &quot;}&quot;&#xa;  Rules = (SyntacticExtension | LexicalExtension | SyntacticRule | LexicalRule)+&#xa;  SyntacticRule = uppercaseid &quot;=&quot; RuleBody&#xa;  LexicalRule = lowercaseid &quot;=&quot; RuleBody&#xa;  SyntacticExtension = uppercaseid &quot;+=&quot; RuleBody&#xa;  LexicalExtension = lowercaseid &quot;+=&quot; RuleBody&#xa;  RuleBody = MatchItem+&#xa;  MatchItem =&#xa;    | &quot;(&quot; MatchItem+ &quot;)&quot; plussuffix -- parenthesizedplus&#xa;    | &quot;(&quot; MatchItem+ &quot;)&quot; -- parenthesized&#xa;    | dqstring -- string&#xa;    | notprefix MatchItem -- notprefixed&#xa;    | MatchItem plussuffix -- plussuffixed&#xa;    | MatchItem AlternateItem+ -- alts&#xa;    | id ~&quot;=&quot; ~&quot;+=&quot;-- single&#xa;&#xa;  AlternateItem = &quot;|&quot; MatchItem&#xa;  plussuffix = &quot;+&quot; ~&quot;=&quot;&#xa;  notprefix = &quot;~&quot;&#xa;  dqstring = &quot;\&quot;&quot; sqchar+ &quot;\&quot;&quot;&#xa;  sqchar =&#xa;    | &quot;\\&quot; &quot;\&quot;&quot; -- escdq&#xa;    | ~&quot;\&quot;&quot; any -- any&#xa;  id = uppercaseid | lowercaseid&#xa;  uppercaseid = upper alnum*&#xa;  lowercaseid = lower alnum*&#xa;}&#xa;" vertex="1">
