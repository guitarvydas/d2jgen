        <mxCell id="e5nCakjjVEugJJ5n87lp-49" parent="1" style="text;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;strokeColor=default;dashed=1;" value="%parameter skip&#xa;%rewrite ohmjsmin {&#xa;&#xa;Main [ id _1 Rules _2] = ‛«id» «_1»«Rules»\n«_2»’&#xa;Rules [ _3+] = ‛«_3»’&#xa;SyntacticRule [ uppercaseid _4 RuleBody] = &#xa;⎡ skip=‛true’&#xa;  ‛\ndef s_«uppercaseid» ():⤷\ntry:⤷«RuleBody»\naccept (&quot;⎨genslprefix ‛«uppercaseid»’⎬&quot;)⤶\nexcept:⤷\nfail (&quot;⎨genslprefix ‛«uppercaseid»’⎬&quot;)\nraise⤶⤶’&#xa;⎦&#xa;&#xa;LexicalRule [ lowercaseid _5 RuleBody] =&#xa;⎡ skip=‛false’&#xa;  ‛\ndef l_«lowercaseid» ():⤷\ntry:⤷«RuleBody»\naccept (&quot;⎨genslprefix ‛«lowercaseid»’⎬&quot;)⤶\nexcept:⤷\nfail (&quot;⎨genslprefix ‛«lowercaseid»’⎬&quot;)\nraise⤶⤶’&#xa;⎦&#xa;&#xa;SyntacticExtension [ uppercaseid _6 RuleBody] =&#xa;⎡ skip=‛true’&#xa;  ‛\ndef s_«uppercaseid» ():⤷\ntry:⤷«RuleBody»\naccept (&quot;⎨genslprefix ‛«uppercaseid»’⎬&quot;)⤶\nexcept:⤷\nfail (&quot;⎨genslprefix ‛«uppercaseid»’⎬&quot;)\nraise⤶⤶’&#xa;⎦&#xa;&#xa;LexicalExtension [ lowercaseid _7 RuleBody] =&#xa;⎡ skip=‛false’&#xa;  ‛\ndef l_«lowercaseid» ():⤷\ntry:⤷«RuleBody»\naccept (&quot;⎨genslprefix ‛«lowercaseid»’⎬&quot;)⤶\nexcept:⤷\nfail (&quot;⎨genslprefix ‛«lowercaseid»’⎬&quot;)\nraise⤶⤶’&#xa;⎦&#xa;&#xa;RuleBody [ MatchItem+] = ‛⎨genskip ‛⟪skip⟫’⎬«MatchItem»⎨genskip ‛⟪skip⟫’⎬’&#xa;MatchItem_parenthesizedplus [ _8 MatchItem+ _9 plussuffix] =‛\nparse_one_or_more («MatchItem»)’&#xa;MatchItem_parenthesized [ _10 MatchItem+ _11] =‛ D«_10»«MatchItem»«_11»’&#xa;MatchItem_string [ dqstring] =‛\n  parse_string («dqstring»)’&#xa;MatchItem_notprefixed [ notprefix MatchItem] =‛ «notprefix»«MatchItem»’&#xa;MatchItem_plussuffixed [ MatchItem plussuffix] =‛\nparse_one_or_more A(⤷lambda : «MatchItem»)⤶’&#xa;MatchItem_alts [ MatchItem AlternateItem+] =‛\nparse_either B([lambda:⤷\n«MatchItem»⤶«AlternateItem»]’&#xa;MatchItem_single [ id] =‛\nparse (⎨genslprefix ‛«id»’⎬)’&#xa;AlternateItem [ _14 MatchItem] = ‛ lambda:⤷\n«MatchItem»⤶’&#xa;plussuffix [ _15] = ‛«_15»’&#xa;notprefix [ _17] = ‛«_17»’&#xa;dqstring [ _18 sqchar+ _19] = ‛«_18»«sqchar»«_19»’&#xa;sqchar_escdq [ _20 _21] =‛«_20»«_21»’&#xa;sqchar_any [ any] =‛«any»’&#xa;id [ _23] = ‛«_23»’&#xa;uppercaseid [ upper alnum*] = ‛«upper»«alnum»’&#xa;lowercaseid [ lower alnum*] = ‛«lower»«alnum»’&#xa;}&#xa;" vertex="1">
