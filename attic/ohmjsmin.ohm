ohmjsmin {
  Main = id "{" Rules "}"
  Rules = (SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid "=" RuleBody
  LexicalRule = lowercaseid "=" RuleBody


  RuleBody = Sequence+

  Sequence = SeqItem+

  Alternation =
   // Alt Begin
   | "(" AltClause+ ")" "+" -- plus
   | "(" AltClause+ ")" "*" -- star
   | "(" AltClause+ ")" "?" -- opt
   | "(" AltClause+ ")"     -- plain

  AltClause =
    // Alt Clause
    "|" Sequence
  
  SeqItem = MatchItem
  MatchItem =
    | Alternation          -- alt
    | "(" SeqItem+ ")" "+" -- parenplus
    | "(" SeqItem+ ")" "*" -- parenstar
    | "(" SeqItem+ ")" "?" -- parenopt
    | "(" SeqItem+ ")"     -- paren
    | Pred "+"             -- plus
    | Pred "*"             -- star
    | Pred "?"             -- optional
    | Pred                 -- plain


  //////////////////////////////////////////////////////////////////////////////
  // Pred returns a function call not wrapped in branching code
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | "~" matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces ("=" | "+=")) -- single

  dqstring = "\"" sqchar+ "\""
  sqchar =
    | "\\" "\"" -- escdq
    | ~"\"" any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
