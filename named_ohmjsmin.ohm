ohmjsmin {
  Main = id _lb Rules _rb
  Rules = (SyntacticRule | LexicalRule)+
  SyntacticRule = uppercaseid _eq RuleBody
  LexicalRule = lowercaseid _eq RuleBody


  RuleBody = SeqGroup

  SeqGroup = Stepper+
  AltGroup =
    | _lp AltItem+ _rp _plus -- plus
    | _lp AltItem+ _rp     -- plain
  AltItem = _orbar Stepper

  Stepper = ParsingCall

  ParsingCall = Pred

  //////////////////////////////////////////////////////////////////////////////
  // Pred is a parsing function call not wrapped in branching code
  // the call returns
  // - a True/False on the value stack (a global variable called "value" in the RWR code)
  // - a "done" control flow blip on its output port ""
  //////////////////////////////////////////////////////////////////////////////
  Pred =
    | _not matchAtom -- neg
    |     matchAtom -- plain

  matchAtom =
    | dqstring -- string
    | id ~(spaces _eq) -- single

  dqstring = _dq sqchar+ _dq
  sqchar =
    | _bslash _dq -- escdq
    | ~_dq any -- any
  id = (uppercaseid | lowercaseid)
  uppercaseid = upper alnum*
  lowercaseid = lower alnum*
}
