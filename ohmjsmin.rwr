%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [x+] = ‛«x»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

RuleBody [x] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑retvar⦒ = True
  «x»
  if ⦑retvar⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

BranchedSequence [item+] =
⎡ logicalop = ‛and’
  ⎡ more = ‛’
    ‛«item»’
  ⎦
⎦

BranchedItem [item] = ‛«item»’

SingleSeqBranchedItem_parenplus [_lp nbbseq _rp op] = ‛«_lp»«nbbseq»«_rp»«op»’
SingleSeqBranchedItem_parenplain [_lp nbbseq _rp] = ‛«_lp»«nbbseq»«_rp»’

SingleSeqBranchedItem_plainplus [bi op] =
⎡ prevretvar = ‛⦑retvar⦒’
  ⎡ retvar = ‛⎨genvar ‛seq’⎬’
    ‛
      ⦑retvar⦒ = True
      if ⦑more⦒ ⦑prevretvar⦒:⤷
        «bi»
        ⦑prevretvar⦒ = ⦑prevretvar⦒ ⦑logicalop⦒ ⦑retvar⦒ 
        while ⦑retvar⦒:⤷
          «bi»
        ⤶
      ⤶
    ’
  ⎦
⎦

SingleSeqBranchedItem_plain [bi] =
⎡ prevretvar = ‛⦑retvar⦒’
  ⎡ retvar = ‛⎨genvar ‛seq’⎬’
    ‛
      ⦑retvar⦒ = True
      if ⦑more⦒ ⦑prevretvar⦒:⤷
        «bi»
      ⤶
      ⦑prevretvar⦒ = ⦑prevretvar⦒ ⦑logicalop⦒ ⦑retvar⦒ 
    ’
  ⎦
⎦

NoBarBranchedSequence [nbssbi+] = ‛«nbssbi»’
NoBarSingleSeqBranchedItem [i] = ‛«i»’

BranchedAlternation_altplus [_lp i+ _rp op] =
⎡ logicalop = ‛and’
  ⎡ more = ‛’
    ⎡ prevretvar = ‛⦑retvar⦒’
      ⎡ retvar = ‛⎨genvar ‛seq’⎬’
	‛
	  # BA_altplus
	  ⦑retvar⦒ = False
	  «i»
	  while ⦑retvar⦒:⤷
	    «i»
	  ⤶
	’
      ⎦
    ⎦
  ⎦
⎦

BranchedAlternation_altplain [_lp i+ _rp] =
⎡ logicalop = ‛and’
  ⎡ more = ‛not’
    ⎡ prevretvar = ‛⦑retvar⦒’
      ⎡ retvar = ‛⎨genvar ‛seq’⎬’
	‛
	  # BA_altplain
	  ⦑retvar⦒ = False
	  «i»
	’
      ⎦
    ⎦
  ⎦
⎦

SingleAltBranchedItem [_bar i] =
⎡ logicalop = ‛or’
  ‛
    if ⦑more⦒ ⦑prevretvar⦒:⤷
      «i»
      ⦑prevretvar⦒ = ⦑prevretvar⦒ ⦑logicalop⦒  ⦑retvar⦒ 
    ⤶
  ’
⎦

SingleBranchedPredItem [p] = ‛⦑retvar⦒ = «p»’





Pred_neg [_not matchAtom] = ‛ not «matchAtom»’
Pred_plain [matchAtom] = ‛ «matchAtom»’

matchAtom_string [dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛ «id»’
uppercaseid [upper alnum*] = ‛«upper»«alnum»’
lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
