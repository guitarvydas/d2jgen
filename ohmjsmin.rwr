%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [x+] = ‛«x»’

SyntacticRule [id _eq RuleBody] = ‛\n«id» «_eq» «RuleBody»’

LexicalRule [id _eq RuleBody] = ‛\n«id» «_eq» «RuleBody»’





RuleBody [x] = ‛«x»’

BranchedSequence [item+] = ‛«item»’
BranchedItem [item] = ‛«item»’

SingleSeqBranchedItem_parenplus [_lp nbbseq _rp op] = ‛«_lp»«nbbseq»«_rp»«op»’
SingleSeqBranchedItem_parenstar [_lp nbbseq _rp op] = ‛«_lp»«nbbseq»«_rp»«op»’
SingleSeqBranchedItem_parenopt [_lp nbbseq _rp op] = ‛«_lp»«nbbseq»«_rp»«op»’
SingleSeqBranchedItem_parenplain [_lp nbbseq _rp] = ‛«_lp»«nbbseq»«_rp»’
SingleSeqBranchedItem_plainplus [bi op] = ‛«bi»«op»’
SingleSeqBranchedItem_plainstar [bi op] = ‛«bi»«op»’
SingleSeqBranchedItem_plainopt [bi op] = ‛«bi»«op»’
SingleSeqBranchedItem_plain [bi] = ‛«bi»’

NoBarBranchedSequence [nbssbi+] = ‛«nbssbi»’
NoBarSingleSeqBranchedItem [i] = ‛«i»’
BranchedAlternation_altplus [_lp i+ _rp op] = ‛«_lp»«i»«_rp»«op»’
BranchedAlternation_altstar [_lp i+ _rp op] = ‛«_lp»«i»«_rp»«op»’
BranchedAlternation_altopt [_lp i+ _rp op] = ‛«_lp»«i»«_rp»«op»’
BranchedAlternation_altplain [_lp i+ _rp] = ‛«_lp»«i»«_rp»’
SingleAltBranchedItem [_bar i] = ‛«_bar»«i»’
SingleBranchedPredItem [p] = ‛«p»’


Pred_neg [_not matchAtom] = ‛«_not»«matchAtom»’
Pred_plain [matchAtom] = ‛«matchAtom»’

matchAtom_string [dqstring] =‛«dqstring»’
matchAtom_single [id] =‛«id»’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛«id»’

uppercaseid [upper alnum*] = ‛«upper»«alnum»’

lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
