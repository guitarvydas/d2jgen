%parameter target
%parameter inout
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [x+] = ‛«x»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

RuleBody [x] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑target⦒ = True
  «x»
  if ⦑target⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

Sequence [item+] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
      ⤶
    ’
  ⎦
⎦


PredItem [p] = 
‛
#B PredItem ⦑target⦒
⦑target⦒ = «p»
#E PredItem ⦑target⦒
’

AlternationGroup_plus [_lp item+ _rp _plus] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B AlternationGroup_plus <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = False
        «item»
      ⤶
      ⦑inout⦒ = ⦑inout⦒ or ⦑target⦒
      while ⦑target⦒:⤷
        «item»
      ⤶
      #E AltItem_pplus -> ⦑inout⦒
    ’
  ⎦
⎦

AlternationGroup_parenthesized [_lp item+ _rp] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛alt’⎬’
    ‛
      #B AltItem_parenthesized <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = False
        «item»
      ⤶
      ⦑inout⦒ = ⦑inout⦒ or ⦑target⦒
      #E AltItem_parenthesized -> ⦑inout⦒
    ’
  ⎦
⎦

AltItem [_bar bitem] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛alt’⎬’
    ‛
      #B AltItem <- ⦑inout⦒
      if not ⦑inout⦒:⤷
        ⦑target⦒ = False
        «bitem»
        ⦑inout⦒ = ⦑inout⦒ or ⦑target⦒
      ⤶
      #E AltItem -> ⦑inout⦒
    ’
  ⎦
⎦

BranchingItem [x] = 
‛
#B BranchingItem <- ⦑target⦒
«x»
#E BranchingItem -> ⦑target⦒
’

SeqItem_plus [item _plus] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B SeqItem_plus <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
	while ⦑target⦒:⤷
          «item»
	⤶
      ⤶
      #E SeqItem_plus -> ⦑inout⦒
    ’
  ⎦
⎦

SeqItem_parenthesized [_lp nbitem+ _rp] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B SeqItem_parenthesized <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «nbitem»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
      ⤶
      #E -> SeqItem_parenthesized ⦑inout⦒
    ’
  ⎦
⎦

SeqItem_sequence [s] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B SeqItem_sequence <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «s»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
      ⤶
      #E SeqItem_sequence -> ⦑inout⦒
    ’
  ⎦
⎦

SeqItem_alternationgroup [a] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛salt’⎬’
    ‛
      #B SeqItem_AlternationGroup <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «a»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
      ⤶
      #E SeqItem_AlternationGroup -> ⦑inout⦒
    ’
  ⎦
⎦

SeqItem_preditem [p] = 
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B SeqItem_preditem <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
      ⤶
      #E SeqItem_preditem -> ⦑inout⦒
    ’
  ⎦
⎦
SeqItem_preditemplus [p _plus] =
⎡ inout = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      #B SeqItem_preditemplus <- ⦑inout⦒
      if ⦑inout⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑inout⦒ = ⦑inout⦒ and ⦑target⦒
        while ⦑target⦒:⤷
	  «p»
	⤶
      ⤶
      #E SeqItem_preditemplus -> ⦑inout⦒
    ’
  ⎦
⎦

NoBarSeqItem [item] = ‛«item»’


Pred_neg [_not matchAtom] = ‛not «matchAtom»’
Pred_plain [matchAtom] = ‛«matchAtom»’

matchAtom_string [dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛ «id»’
uppercaseid [upper alnum*] = ‛«upper»«alnum»’
lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
