%parameter more
%parameter conjoin
%parameter previousconjoin
%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%rewrite ohmjsmin {

Main [ id _1 Rules _2] = 
  ⎡ conjoin=‛and’
    ‛«Rules»’
  ⎦

Rules [ _3+] = ‛«_3»’
SyntacticRule [ id _4 RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛r⎨genvar⎬’
      ⎡ more=‛⟪retvar⟫’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n⟪retvar⟫ = True«RuleBody»\n⎨finalexit ‛⟪retvar⟫’ ‛⟪rulename⟫’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦
LexicalRule [ id _5 RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛r⎨genvar⎬’
      ⎡ more=‛⟪retvar⟫’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n⟪retvar⟫ = True«RuleBody»\n⎨finalexit ‛⟪retvar⟫’ ‛⟪rulename⟫’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦
LexicalExtension [ id _7 RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛r⎨genvar⎬’
      ⎡ more=‛⟪retvar⟫’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n⟪retvar⟫ = True«RuleBody»\n⎨finalexit ‛⟪retvar⟫’ ‛⟪rulename⟫’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦
RuleBody [ alternates RuleBody?] = ‛«alternates»«RuleBody»’
UnnamedAlternates_unnamedalts [ AltUnnamed+] = ‛«AltUnnamed»’
UnnamedAlternates_single [ UnnamedMatchSequence] =‛«UnnamedMatchSequence»’
AltUnnamed [ _11 UnnamedMatchSequence] = ‛«UnnamedMatchSequence»’
UnnamedMatchSequence [ MatchSequence] = ‛«MatchSequence»’
MatchSequence [ Iter MatchSequence?] = ‛\nif ⟪more⟫:⤷\n«Iter»«MatchSequence»⤶’
MatchItem_nonparenthesized [item] = ‛⟪retvar⟫ = ⟪retvar⟫ ⟪conjoin⟫ «item»’
MatchItem_parenthesized [item] = ‛«item»’
Iter_zeroormore [ Pred _13] =‛«Pred»«_13»’
Iter_oneormore [ Pred _14] =‛«Pred»«_14»’
Iter_optional [ Pred _15] =‛«Pred»«_15»’
Iter_plain [ Pred] =‛«Pred»’
Pred_not [ _16 Base] =
  ‛(not «Base»)’
Pred_plain [ Base] =‛«Base»’
Base_parenthesized [ lpar UnnamedAlternates rpar] =
⎡ previousconjoin=‛⟪conjoin⟫’
  ⎡ conjoin=‛and’
    ⎡ previousretvar=‛⟪retvar⟫’
      ⎡ retvar=‛r⎨genvar⎬’
        ⎡ more=‛⟪retvar⟫’
	  ‛\n⟪retvar⟫ = True«UnnamedAlternates»; \n⟪previousretvar⟫ = ⟪previousretvar⟫ ⟪previousconjoin⟫ ⟪retvar⟫’
        ⎦
      ⎦
    ⎦
  ⎦
⎦

Base_alts [ lpar _bar_lookahead UnnamedAlternates rpar] =
⎡ previousconjoin=‛⟪conjoin⟫’
  ⎡ conjoin=‛or’
    ⎡ previousretvar=‛⟪retvar⟫’
      ⎡ retvar=‛r⎨genvar⎬’
        ⎡ more=‛not ⟪retvar⟫’
         ‛\n⟪retvar⟫ = False«UnnamedAlternates»; \n⟪previousretvar⟫ = ⟪previousretvar⟫ ⟪previousconjoin⟫ ⟪retvar⟫’
        ⎦
      ⎦
    ⎦
  ⎦
⎦

Base_atom [ matchAtom] =‛«matchAtom»’
matchAtom_string [ dqstring] =‛parse_string («dqstring»)’
matchAtom_single [ id] =‛«id» ()’
dqstring [ _22 sqchar+ _23] = ‛«_22»«sqchar»«_23»’
sqchar_escdq [ _24 _25] =‛«_24»«_25»’
sqchar_any [ any] =‛«any»’
id [ _27] = ‛«_27»’
uppercaseid [ upper alnum*] = ‛«upper»«alnum»’
lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
