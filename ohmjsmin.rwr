%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename

%rewrite ohmjsmin {


Main [ id _lb Rules _rb] =
  ⎡ logicalop=‛and’
    ‛from plib2 import *\n«Rules»’
  ⎦

Rules [ _1+] = ‛«_1»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar ‛topsyn’⎬’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar ‛toplex’⎬’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
    ⎦
  ⎦
⎦


LexicalExtension [ id _peq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar ‛topxlex’⎬’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
    ⎦
  ⎦
⎦






RuleBody [x+] = ‛⦑retvar⦒ = True«x»’

AndSequence [i+] =
⎡logicalop=‛and’
  ‛«i»’
⎦

Alternation_plus [lp first more? rp _plus] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛altp’⎬’
    ‛
    «first»
    ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    while ⦑retvar⦒:⤷
      «more»⤶
    ’
  ⎦
⎦
Alternation_star [lp alt rp _star] =
    ‛
    while ⦑retvar⦒:⤷
      «more»⤶
    ’
Alternation_opt [lp alt rp _opt] =
    ‛
    if ⦑retvar⦒:⤷
      «alt»⤶
    ’
Alternation_plain [lp first more? rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ logicalop=‛or’
      ‛
      # alt plain 1
      «first»
      # alt plain 2
      «more»
      # alt plain ending
      ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
      # alt plain end
      ’
    ⎦
  ⎦
⎦

AltFirst [_bar seq] = 
⎡ logicalop=‛or’
    ‛
      # alt first 1
      ⦑retvar⦒ = False
      # alt first 2
      if not ⦑retvar⦒:⤷
        # alt first 3
	«seq»⤶
      # alt first end
    ’
⎦

Altrec_rec [_bar seq rec] =
    ‛
      # alt rec 1
      if not ⦑retvar⦒:⤷
        # alt rec 2
	«seq»⤶
      # alt rec 3
      «rec»
      # alt rec end
    ’

Altrec_last [_bar seq] =
    ‛
      # alt last 1
      if not ⦑retvar⦒:⤷
        # alt last 2
	«seq»⤶
      # alt last end
    ’

SingleItem [matchitem] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛seqi’⎬’
    ‛
      # seqi 1
      ⦑retvar⦒ = True
      # seqi 2
      «matchitem»
      # seqi 3
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
      # seqi fini
    ’
  ⎦
⎦

MatchItem_alt [a] = ‛«a»’

MatchItem_parenplus [lp i rp _op] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛parenp’⎬’
    ‛
      ⦑retvar⦒ = True
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
      while ⦑retvar⦒:⤷
        «i»⤶    
    ’
  ⎦
⎦

MatchItem_parenstar [lp i rp _op] =
  ⎡ retvar=‛temp’
    ‛
     temp = True
      while ⦑retvar⦒:⤷
        «i»⤶    
    ’
  ⎦

MatchItem_parenopt [lp i rp _op] =
    ‛
      «i»
    ’

MatchItem_paren [lp i rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      ⦑retvar⦒ = True
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦

MatchItem_plus [ Pred _plus] = ‛⦑retvar⦒ = «Pred»\nif ⦑retvar⦒:⤷\nwhile «Pred»:⤷\npass⤶⤶’
MatchItem_star [ Pred _star] = ‛ \nwhile «Pred»:⤷\npass⤶’
MatchItem_optional [ Pred _opt] = ‛\n«Pred»’

MatchItem_plain [ Pred] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛iplain’⎬’
    ‛
      ⦑retvar⦒ = «Pred»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦



Pred_neg [ _not matchAtom] = ‛ not «matchAtom»’
Pred_plain [ matchAtom] = ‛ «matchAtom»’

matchAtom_string [ dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [ id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [ dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [ _bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [ _3] = ‛ «_3»’

uppercaseid [ upper alnum*] = ‛«upper»«alnum»’

lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
