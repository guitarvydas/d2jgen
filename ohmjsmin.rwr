%parameter targetid
%parameter savedtargetid
%parameter rulename
%parameter savedbypass
%parameter bypass
%parameter skip

%rewrite ohmjsmin {

Main [ id _lb Rules _rb] = ‛from plib2 import *\nimport sys\n«Rules»’

Rules [ _1+] = ‛«_1»’

SyntacticRule [ uppercaseid _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«uppercaseid»’
    ⎡bypass=‛⎨resetgenvar⎬⎨genvar ‛bp_syn’⎬’
      ⎡targetid=‛⎨genvar ‛v’⎬’
	‛\ndef «uppercaseid» ():⤷«RuleBody»⤶’
      ⎦
    ⎦
  ⎦
⎦

LexicalRule [ lowercaseid _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«lowercaseid»’
    ⎡bypass=‛⎨resetgenvar⎬⎨genvar ‛bp_lex’⎬’
      ⎡targetid=‛⎨genvar ‛v’⎬’
	‛\ndef «lowercaseid» ():⤷«RuleBody»⤶’
      ⎦
    ⎦
  ⎦
⎦

RuleBody [Group] =
  ‛
    begin ("⦑rulename⦒")
    ⦑bypass⦒=declare(False)
    ⦑targetid⦒=declare(False)
    «Group»
    if ⦑targetid⦒:⤷
      return accept ("⦑rulename⦒")
    ⤶
    else:⤷
      return fail ("⦑rulename⦒")
    ⤶
  ’


Group [x+] =
⎡ savedtargetid = ‛⦑targetid⦒’
  ⎡ targetid = ‛⎨genvar ‛v’⎬’
    ⎡ savedbypass = ‛⦑bypass⦒’
      ⎡ bypass = ‛⎨genvar ‛bp_’⎬’	
	‛
          ⦑bypass⦒ = declare (False)
	  ⦑targetid⦒ = declare (None)
	  «x»
	  ⦑savedtargetid⦒ = ⦑targetid⦒ 
          ⦑savedbypass⦒ = ⦑targetid⦒ 
	’
      ⎦
    ⎦
  ⎦
⎦

SequentialItem_plus [x _plus] =
‛
  if not ⦑bypass⦒:⤷
    «x»
    ⦑bypass⦒ = not ⦑targetid⦒⤶
    while ⦑targetid⦒:⤷
      ⦑bypass⦒ = False
      «x»⤶
’
SequentialItem_plain [x] =
‛
  if not ⦑bypass⦒:⤷
    «x»
    ⦑bypass⦒ = not ⦑targetid⦒⤶
’




AltGroup_plus [_lp alt+ _rp _plus] =
⎡ savedtargetid = ‛⦑targetid⦒’
  ⎡ targetid = ‛⎨genvar ‛v’⎬’
    ⎡ savedbypass = ‛⦑bypass⦒’
      ⎡ bypass = ‛⎨genvar ‛bp_’⎬’	
      ‛
	⦑bypass⦒ = declare (False)
	⦑targetid⦒ = declare (None)
	«alt»
	⦑savedtargetid⦒ = ⦑targetid⦒ 
	⦑savedbypass⦒ = ⦑bypass⦒
	while ⦑targetid⦒:⤷
          ⦑bypass⦒ = False
	  «alt»⤶
      ’
      ⎦
    ⎦
  ⎦
⎦

AltGroup_plain [_lp x+ _rp] =
⎡ savedtargetid = ‛⦑targetid⦒’
  ⎡ targetid = ‛⎨genvar ‛v’⎬’	
    ⎡ savedbypass = ‛⦑bypass⦒’
      ⎡ bypass = ‛⎨genvar ‛bp_’⎬’	
      ‛
	⦑bypass⦒ = declare (False)
	⦑targetid⦒ = declare (None)
	«x»
	⦑savedtargetid⦒ = ⦑targetid⦒ 
	⦑savedbypass⦒ = ⦑bypass⦒ 
      ’
      ⎦
    ⎦
  ⎦
⎦

AltItem [_orbar group] =
‛
  if not ⦑bypass⦒:⤷
    «group»
    ⦑bypass⦒ = ⦑targetid⦒⤶
’

ParsingCall [ Pred] =
‛
⦑targetid⦒ = «Pred»
’




Pred_neg [_not matchAtom] = ‛not «matchAtom»’
Pred_plain [matchAtom] = ‛«matchAtom»’

matchAtom_string [dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛ «id»’
uppercaseid [upper alnum*] = ‛«upper»«alnum»’
lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
