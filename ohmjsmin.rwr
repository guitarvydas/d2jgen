%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [ id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [ _1+] = ‛«_1»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦





RuleBody [x+] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑retvar⦒ = True
  «x»
  if ⦑retvar⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

Sequence [i+] =
⎡previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛seq’⎬’
    ⎡more=‛’
      ⎡logicalop=‛and’
        ‛
	  # Sequence
          ⦑retvar⦒=True
	  if ⦑retvar⦒:⤷
            «i»
	  ⤶
	  ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_plus [lp clauses+ rp _plus] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
	  # Alt Begin +
          ⦑retvar⦒=False
          «clauses»
	  ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
          while ⦑retvar⦒:⤷
            «alts»
	  ⤶
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_star [lp clauses+ rp _star] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
	  # Alt Begin *
          ⦑retvar⦒=False
          while ⦑retvar⦒:⤷
            «clauses»
	  ⤶
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_opt [lp clauses+ rp _opt] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
	  # Alt Begin ?
          ⦑retvar⦒=True
          «clauses»
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_plain [lp clauses+ rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
	  # Alt Begin
	  ⦑retvar⦒ = False
          «clauses»
	’
      ⎦
    ⎦
  ⎦
⎦

AltClause [_bar seq] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ‛
      # Alt Clause
       ⦑retvar⦒ = False
      if not ⦑previousretvar⦒:⤷
	«seq»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦
SeqItem [m] =
‛
    # SeqItem
    if ⦑retvar⦒:⤷
      «m»
    ⤶
’

MatchItem_alt [a] = ‛«a»’

MatchItem_parenplus [lp i rp _op] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛parenp’⎬’
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
      if ⦑retvar⦒:⤷
        while ⦑retvar⦒:⤷
          «i»
        ⤶
      ⤶
    ’
  ⎦
⎦

MatchItem_parenstar [lp i rp _op] =
  ⎡ retvar=‛ignore’
    ‛
      while ⦑retvar⦒:⤷
        «i»⤶    
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ True
    ’
  ⎦

MatchItem_parenopt [lp i rp _op] =
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ True
    ’

MatchItem_paren [lp i rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦

MatchItem_plus [ Pred _plus] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      ⦑retvar⦒ = «Pred»
      if ⦑retvar⦒:⤷
	while «Pred»:⤷
	  pass
	⤶
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦

MatchItem_star [ Pred _star] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      if ⦑retvar⦒:⤷
	while «Pred»:⤷
	  pass
	⤶
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ True
    ’
  ⎦
⎦

MatchItem_optional [ Pred _opt] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      if ⦑retvar⦒:⤷
	«Pred»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ True
    ’
  ⎦
⎦

MatchItem_plain [ Pred] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛iplain’⎬’
    ‛
      ⦑retvar⦒ = True
      if  ⦑retvar⦒:⤷
        ⦑retvar⦒ = «Pred»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦



Pred_neg [ _not matchAtom] = ‛ not «matchAtom»’
Pred_plain [ matchAtom] = ‛ «matchAtom»’

matchAtom_string [ dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [ id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [ dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [ _bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [ _3] = ‛ «_3»’

uppercaseid [ upper alnum*] = ‛«upper»«alnum»’

lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
