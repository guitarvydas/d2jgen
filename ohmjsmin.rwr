%parameter target
%parameter mytarget
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [x+] = ‛«x»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

RuleBody [x] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑target⦒ = True
  «x»
  if ⦑target⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

Sequence [item+] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
    ’
  ⎦
⎦


PredItem [p] = ‛⦑target⦒ = «p»’
Alternation_plus [alt _plus] =‛«alt»«_plus»’
Alternation_parenthesized [_lp item+ _rp] = ‛«item»’

AltItem [_bar bitem] = ‛«_bar»«bitem»’
BranchingItem [x] = ‛«x»’

SeqItem_plus [item _plus] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
	while ⦑target⦒:⤷
          «item»
	⤶
      ⤶
    ’
  ⎦
⎦

SeqItem_parenthesized [_lp nbitem+ _rp] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «nbitem»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
    ’
  ⎦
⎦

SeqItem_sequence [s] = ‛«s»’
SeqItem_alternation [a] = ‛«a»’

SeqItem_preditem [p] = 
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
    ’
  ⎦
⎦
SeqItem_preditemplus [p _plus] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
        while ⦑target⦒:⤷
	  «p»
	⤶
      ⤶
    ’
  ⎦
⎦

NoBarSeqItem [item] = ‛«item»’


Pred_neg [_not matchAtom] = ‛not «matchAtom»’
Pred_plain [matchAtom] = ‛«matchAtom»’

matchAtom_string [dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛ «id»’
uppercaseid [upper alnum*] = ‛«upper»«alnum»’
lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
