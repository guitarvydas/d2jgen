%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [ id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [ _1+] = ‛«_1»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦





RuleBody [x] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑retvar⦒ = True
  «x»
  if ⦑retvar⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

BranchedItem [x] = ‛«x»’

BranchedSequence_parenplus [lp britem rp _plus] = ‛NIY’
BranchedSequence_parenstar [lp britem rp _star] = ‛NIY’
BranchedSequence_parenopt [lp britem rp _opt]   = ‛NIY’
BranchedSequence_parenplain [lp britem rp]      = ‛NIY’
BranchedSequence_plain [britem]                  =
⎡ previousretvar = ‛⦑retvar⦒’
  ⎡ retvar = ‛⎨genvar ‛seq’⎬’
    ‛
      ⦑retvar⦒ = None
      if ⦑previousretvar⦒:⤷
        «britem»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    ’
  ⎦
⎦

BranchedAlternation_parenplus [lp altitem rp _plus] = ‛NIY’
BranchedAlternation_parenstar [lp altitem rp _star] = ‛NIY’
BranchedAlternation_parenopt [lp altitem rp _opt]   = ‛NIY’
BranchedAlternation_parenplain [lp altitem rp]      =
⎡ previousretvar = ‛⦑retvar⦒’
  ⎡ retvar = ‛⎨genvar ‛alt’⎬’
    ‛
      ⦑retvar⦒ = None
      if not ⦑previousretvar⦒:⤷
        «altitem»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    ’
  ⎦
⎦

BranchedPred [p] =
⎡ previousretvar = ‛⦑retvar⦒’
  ‛
    ⦑previousretvar⦒ = «p»
  ’
⎦

AltBranchedItem [_bar item] = ‛«item»’

Pred_neg [ _not matchAtom] = ‛ not «matchAtom»’
Pred_plain [ matchAtom] = ‛ «matchAtom»’

matchAtom_string [ dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [ id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [ dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [ _bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [ _3] = ‛ «_3»’

uppercaseid [ upper alnum*] = ‛«upper»«alnum»’

lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
