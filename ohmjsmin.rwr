%parameter target
%parameter mytarget
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [x+] = ‛«x»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ target=‛⎨resetgenvar⎬r’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

RuleBody [x] = ‛
def ⦑rulename⦒ ():⤷
  begin ("⦑rulename⦒")
  ⦑target⦒ = True
  «x»
  if ⦑target⦒:⤷
    return accept ("⦑rulename⦒")⤶
  else:⤷
    return fail ("⦑rulename⦒")⤶
 ⤶’

Sequence [item+] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
    ’
  ⎦
⎦


PredItem [p] = 
‛
# begin PredItem
⦑target⦒ = «p»
# end PredItem
’

Alternation_plus [alt _plus] =
‛
# begin Alternation_plus
«alt»«_plus»
# end Alternation_plus
’

Alternation_parenthesized [_lp item+ _rp] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin AltItem_parenthesized
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = False
        «item»
      ⤶
      ⦑mytarget⦒ = ⦑mytarget⦒ or ⦑target⦒
      # end AltItem_parenthesized
    ’
  ⎦
⎦

AltItem [_bar bitem] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin AltItem
      if not ⦑mytarget⦒:⤷
        ⦑target⦒ = False
        «bitem»
      ⤶
      ⦑mytarget⦒ = ⦑mytarget⦒ or ⦑target⦒
      # end AltItem
    ’
  ⎦
⎦

BranchingItem [x] = 
‛
# begin BranchingItem
«x»
# end BranchingItem
’

SeqItem_plus [item _plus] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin SeqItem_plus
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «item»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
	while ⦑target⦒:⤷
          «item»
	⤶
      ⤶
      # end SeqItem_plus
    ’
  ⎦
⎦

SeqItem_parenthesized [_lp nbitem+ _rp] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin SeqItem_parenthesized
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «nbitem»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
      # end SeqItem_parenthesized
    ’
  ⎦
⎦

SeqItem_sequence [s] =
‛
# end SeqItem_sequence
«s»
# end SeqItem_sequence
’

SeqItem_alternation [a] =
    ‛
    # begin SeqItem_alternation
    «a»
    # end SeqItem_alternation
    ’

SeqItem_preditem [p] = 
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin SeqItem_preditem
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
      ⤶
      # end SeqItem_preditem
    ’
  ⎦
⎦
SeqItem_preditemplus [p _plus] =
⎡ mytarget = ‛⦑target⦒’
  ⎡ target=‛⎨genvar ‛seq’⎬’
    ‛
      # begin SeqItem_preditemplus
      if ⦑mytarget⦒:⤷
        ⦑target⦒ = True
        «p»
        ⦑mytarget⦒ = ⦑mytarget⦒ and ⦑target⦒
        while ⦑target⦒:⤷
	  «p»
	⤶
      ⤶
      # end SeqItem_preditemplus
    ’
  ⎦
⎦

NoBarSeqItem [item] = ‛«item»’


Pred_neg [_not matchAtom] = ‛not «matchAtom»’
Pred_plain [matchAtom] = ‛«matchAtom»’

matchAtom_string [dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [_bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [id] = ‛ «id»’
uppercaseid [upper alnum*] = ‛«upper»«alnum»’
lowercaseid [lower alnum*] = ‛«lower»«alnum»’
}
