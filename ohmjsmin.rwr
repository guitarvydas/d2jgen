%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename
%parameter logicalop
%parameter more

%rewrite ohmjsmin {

Main [ id _lb Rules _rb] = ‛from plib2 import *\n«Rules»’

Rules [ _1+] = ‛«_1»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar ‛topsyn’⎬’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar ‛toplex’⎬’
       ‛«RuleBody»’
    ⎦
  ⎦
⎦





RuleBody [x+] = ‛
def «id» ():⤷
  begin ("«id»")
  ⦑retvar⦒ = True
  «x»
  if ⦑retvar⦒:
    return accept ("«id»")
  else:
    return fail ("«id»")
 ⤶’

Sequence [i+] =
⎡previousretvar=⦑retvar⦒
  ⎡ retvar=‛⎨genvar ‛seq’⎬’
    ⎡more=‛’
      ⎡logicalop=‛and’
        ⦑retvar⦒=‛True’
        ‛«i»’
      ⎦
    ⎦
  ⎦
⎦

Alternation_plus [lp alts+ rp _plus] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
          ⦑retvar⦒=‛False’
          «alts»
	  ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
          while ⦑retvar⦒:⤷
            «alts»
	  ⤶
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_star [lp alts+ rp _star] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
          ⦑retvar⦒=‛False’
          while ⦑retvar⦒:⤷
            «alts»
	  ⤶
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_opt [lp alts+ rp _opt] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛
          ⦑retvar⦒=‛True’
          «alts»
        ’
      ⎦
    ⎦
  ⎦
⎦

Alternation_plain [lp alts+ rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛alt’⎬’
    ⎡ more=‛not’
      ⎡ logicalop=‛or’
        ‛«alts»’
      ⎦
    ⎦
  ⎦
⎦

AltItem [_bar seq] = ‛«seq»’

SeqItem [x] =
‛
  if ⦑retvar⦒:⤷
    «x»
  ⤶
’

SeqItem_alt [a] = ‛«a»’

SeqItem_parenplus [lp i rp _op] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛parenp’⎬’
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
      if ⦑retvar⦒:⤷
        while ⦑retvar⦒:⤷
          «i»
        ⤶
      ⤶
    ’
  ⎦
⎦

SeqItem_parenstar [lp i rp _op] =
  ⎡ retvar=‛temp’
    ‛
      while ⦑retvar⦒:⤷
        «i»⤶    
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒‛ ‛True’
    ’
  ⎦

SeqItem_parenopt [lp i rp _op] =
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒‛ ‛True’
    ’

SeqItem_paren [lp i rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛paren’⎬’
    ‛
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦

SeqItem_plus [ Pred _plus] =
‛
  ⦑retvar⦒ = «Pred»
  if ⦑retvar⦒:⤷
    while «Pred»:⤷
      pass
    ⤶
  ⤶
  ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
’

SeqItem_star [ Pred _star] =
‛
  if ⦑retvar⦒:⤷
    while «Pred»:⤷
      pass
    ⤶
  ⤶
  ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ‛True’
’

SeqItem_optional [ Pred _opt] =
‛
  if ⦑retvar⦒:⤷
    «Pred»
  ⤶
  ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ‛True’
’

SeqItem_plain [ Pred] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar ‛iplain’⎬’
    ‛
      if ⦑retvar⦒:⤷
        ⦑retvar⦒ = «Pred»
      ⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑logicalop⦒ ⦑retvar⦒
    ’
  ⎦
⎦



Pred_neg [ _not matchAtom] = ‛ not «matchAtom»’
Pred_plain [ matchAtom] = ‛ «matchAtom»’

matchAtom_string [ dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [ id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [ dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [ _bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [ _3] = ‛ «_3»’

uppercaseid [ upper alnum*] = ‛«upper»«alnum»’

lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
