%parameter retvar
%parameter previousretvar
%parameter skip
%parameter rulename

%rewrite ohmjsmin {


Main [ id _lb Rules _rb] =
  ⎡ conjoin=‛and’
    ‛from plib2 import *\n«Rules»’
  ⎦

Rules [ _1+] = ‛«_1»’

SyntacticRule [ id _eq RuleBody] =
⎡ skip=‛true’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar⎬’
      ⎡ more=‛⦑retvar⦒’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦

LexicalRule [ id _eq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar⎬’
      ⎡ more=‛⦑retvar⦒’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦


LexicalExtension [ id _peq RuleBody] =
⎡ skip=‛false’
  ⎡ rulename=‛«id»’
    ⎡ retvar=‛⎨freshgenvar⎬’
      ⎡ more=‛⦑retvar⦒’
        ‛\ndef «id» ():⤷\nbegin ("«id»")\n«RuleBody»\n⎨finalexit ‛⦑retvar⦒’ ‛⦑rulename⦒’⎬⤶’
      ⎦
    ⎦
  ⎦
⎦






RuleBody_alt [alts] = ‛⦑retvar⦒ = True«alts»’
RuleBody_anded [andseq] = ‛⦑retvar⦒ = True«andseq»’

AndSequence [i+] =
⎡conjoin=‛and’
  ‛«i»’
⎦

Alternation_plus [lp Altrec rp _plus] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
    ⦑retvar⦒ = False
    «Altrec»⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    while ⦑retvar⦒:⤷
      «Altrec»⤶
    ’
  ⎦
⎦
Alternation_star [lp Altrec rp _star] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
    ⦑retvar⦒ = True
    while ⦑retvar⦒:⤷
      «Altrec»⤶
    ’
  ⎦
⎦
Alternation_opt [lp Altrec rp _opt] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
    ⦑retvar⦒=False
    «Altrec»
    ’
  ⎦
⎦
Alternation_plain [lp Altrec rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛⦑retvar⦒ = False
    «Altrec»⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒’
  ⎦
⎦

Altrec_rec [_bar seq rec] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = False
      if not ⦑retvar⦒:⤷
	«seq»⤶
      «rec»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    ’
  ⎦
⎦
Altrec_last [_bar seq] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = False
      if not ⦑retvar⦒:⤷
	«seq»⤶
      ⦑previousretvar⦒ = ⦑previousretvar⦒ or ⦑retvar⦒
    ’
  ⎦
⎦

SingleItem [matchitem] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = True
      «matchitem»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑conjoin⦒ ⦑retvar⦒
    ’
  ⎦
⎦

MatchItem_alt [a] = ‛«a»’

MatchItem_parenplus [lp i rp _op] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = True
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑conjoin⦒ ⦑retvar⦒
      while ⦑retvar⦒:⤷
        «i»⤶    
    ’
  ⎦
⎦

MatchItem_parenstar [lp i rp _op] =
  ⎡ retvar=‛temp’
    ‛
     temp = True
      while ⦑retvar⦒:⤷
        «i»⤶    
    ’
  ⎦

MatchItem_parenopt [lp i rp _op] =
    ‛
      «i»
    ’

MatchItem_paren [lp i rp] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = True
      «i»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑conjoin⦒ ⦑retvar⦒
    ’
  ⎦
⎦

MatchItem_plus [ Pred _plus] = ‛⦑retvar⦒ = «Pred»\nif ⦑retvar⦒:⤷\nwhile «Pred»:⤷\npass⤶⤶’
MatchItem_star [ Pred _star] = ‛ \nwhile «Pred»:⤷\npass⤶’
MatchItem_optional [ Pred _opt] = ‛\n«Pred»’

MatchItem_plain [ Pred] =
⎡ previousretvar=‛⦑retvar⦒’
  ⎡ retvar=‛⎨genvar⎬’
    ‛
      ⦑retvar⦒ = «Pred»
      ⦑previousretvar⦒ = ⦑previousretvar⦒ ⦑conjoin⦒ ⦑retvar⦒
    ’
  ⎦
⎦



Pred_neg [ _not matchAtom] = ‛ not «matchAtom»’
Pred_plain [ matchAtom] = ‛ «matchAtom»’

matchAtom_string [ dqstring] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛parse_string («dqstring»)’⎬’
matchAtom_single [ id] =‛⎨genskipmaybe ‛⦑skip⦒’ ‛«id» ()’⎬’

dqstring [ dq sqchar+ dq2] = ‛«dq»«sqchar»«dq2»’

sqchar_escdq [ _bslash dq] = ‛«_bslash»«dq»’
sqchar_any [any] = ‛«any»’

id [ _3] = ‛ «_3»’

uppercaseid [ upper alnum*] = ‛«upper»«alnum»’

lowercaseid [ lower alnum*] = ‛«lower»«alnum»’
}
